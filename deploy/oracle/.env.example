# ============ BIDLY deploy env (Oracle) ============
# Copy to .env and fill in every REPLACE_ME.

# --- Public endpoints -------------------------------------------------
# If you have a domain: SITE_DOMAIN=bidly.example.com
# PUBLIC_API_URL must be https://<SITE_DOMAIN>  (Caddy routes /api/* to the API)
SITE_DOMAIN=REPLACE_ME_DOMAIN_OR_IP
PUBLIC_API_URL=https://REPLACE_ME_DOMAIN_OR_IP

# --- Database ---------------------------------------------------------
POSTGRES_PASSWORD=REPLACE_ME_STRONG_PASSWORD

# --- Auth secrets (>= 32 chars) ---------------------------------------
AUTH_SECRET=REPLACE_ME_64_CHAR_RANDOM
REFRESH_SECRET=REPLACE_ME_64_CHAR_RANDOM

# --- App --------------------------------------------------------------
CORS_ORIGINS=https://REPLACE_ME_DOMAIN_OR_IP
API_URL=https://REPLACE_ME_DOMAIN_OR_IP
APP_URL=https://REPLACE_ME_DOMAIN_OR_IP
STORAGE_DRIVER=local
PAYMENT_PROVIDER=internal
PAYMENT_SANDBOX=true
PAYMENT_WEBHOOK_SECRET=REPLACE_ME_RANDOM
# These must NOT be "log" in production. Use the no-op adapters:
EMAIL_PROVIDER=console
SMS_PROVIDER=console
DEMO_MODE=false
LOG_LEVEL=info
LOG_PRETTY=false
RATE_LIMIT_ENABLED=true
DEFAULT_CURRENCY=MAD
DEFAULT_COUNTRY=MA
DEFAULT_LOCALE=ar
SUPPORTED_LOCALES=ar,fr,en
