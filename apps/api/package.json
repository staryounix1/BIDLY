{
  "name": "@bidly/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint: api (placeholder)'",
    "test:unit": "BIDLY_TEST_SCOPE=apps/api/src vitest run --config ../../vitest.config.ts --no-file-parallelism",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@bidly/config": "workspace:*",
    "@bidly/money": "workspace:*",
    "@bidly/state-machines": "workspace:*",
    "@bidly/types": "workspace:*",
    "@bidly/validation": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/sensible": "^6.0.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "hash-wasm": "^4.12.0",
    "jose": "^5.9.6",
    "nanoid": "^5.0.9",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2"
  }
}
