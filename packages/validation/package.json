{
  "name": "@bidly/validation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./common": {
      "types": "./dist/common.d.ts",
      "import": "./dist/common.js",
      "default": "./dist/common.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "BIDLY_TEST_SCOPE=packages/validation/src vitest run --config ../../vitest.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@bidly/config": "workspace:*",
    "zod": "^3.24.1"
  },
  "files": [
    "dist",
    "src"
  ]
}
