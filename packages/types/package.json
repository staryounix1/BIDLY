{
  "name": "@bidly/types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "import": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "BIDLY_TEST_SCOPE=packages/types/src vitest run --config ../../vitest.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "files": [
    "dist",
    "src"
  ]
}
