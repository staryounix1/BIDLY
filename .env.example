# =====================================================================
# BIDLY — environment configuration (TEMPLATE)
# Copy to `.env.local` (dev) or set in your hosting provider's secret
# manager (preview/staging/production). NEVER commit real values.
# =====================================================================

# --- Application -----------------------------------------------------
NODE_ENV=development
APP_NAME=BIDLY
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001
# Comma-separated. The API rejects requests from origins not listed.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Market / locale defaults (all overridable in the DB `settings`) --
DEFAULT_COUNTRY=MA
DEFAULT_CURRENCY=MAD
DEFAULT_LOCALE=ar
SUPPORTED_LOCALES=ar,fr,en
DEFAULT_TIMEZONE=Africa/Casablanca
LAUNCH_CITIES=Rabat,Salé,Témara

# --- Web / Admin client (NEXT_PUBLIC_* is inlined into the browser) ----
# Only ever put non-secret values here: anything NEXT_PUBLIC_* is public.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=MAD
NEXT_PUBLIC_DEFAULT_COUNTRY=MA
NEXT_PUBLIC_DEMO_MODE=false
# Optional. Free CARTO basemap key (no CARTO account needed):
# https://carto.com/basemaps/apikey/ . With it the map uses CARTO Voyager;
# without it the app falls back to the keyless OSM raster style.
NEXT_PUBLIC_CARTO_API_KEY=

# --- Database --------------------------------------------------------
# Supabase PostgreSQL — use the pooled connection string for the API.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=true

# --- Supabase --------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Authentication --------------------------------------------------
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-64-char-random-secret
REFRESH_SECRET=replace-with-a-different-64-char-random-secret
ACCESS_TOKEN_TTL_MINUTES=15
SESSION_TTL_DAYS=30
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4
OTP_LENGTH=6
OTP_TTL_SECONDS=300
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# --- Redis (cache, rate limiting, queues, socket adapter) ------------
REDIS_URL=redis://localhost:6379
REDIS_TLS=false
CACHE_TTL_SECONDS=300

# --- Object storage (S3-compatible; Supabase Storage works) ----------
STORAGE_DRIVER=s3
S3_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3
S3_REGION=us-east-1
S3_BUCKET=bidly-uploads
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=900
UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_VIDEO_MB=50

# --- Payments (provider abstraction; leave as `internal` for dev) ----
PAYMENT_PROVIDER=internal
PAYMENT_WEBHOOK_SECRET=your-webhook-signing-secret
PAYMENT_SANDBOX=true

# CMI (Morocco)
CMI_MERCHANT_ID=
CMI_STORE_KEY=
CMI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

# --- Email (leave `log` for dev — prints to console) -----------------
EMAIL_PROVIDER=log
EMAIL_FROM=no-reply@bidly.ma
EMAIL_FROM_NAME=BIDLY
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
RESEND_API_KEY=

# --- SMS (leave `log` for dev) ---------------------------------------
SMS_PROVIDER=log
SMS_SENDER=BIDLY
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=

# --- Push notifications ----------------------------------------------
PUSH_PROVIDER=log
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Maps / geocoding (launch market) --------------------------------
MAP_PROVIDER=log
MAP_API_KEY=
MAP_DEFAULT_CENTER_LAT=34.020882
MAP_DEFAULT_CENTER_LNG=-6.841650

# --- Identity / KYC verification -------------------------------------
VERIFY_PROVIDER=manual
VERIFY_API_KEY=

# --- AI (phase 3; disabled by default) -------------------------------
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=

# --- Feature flags & demo --------------------------------------------
DEMO_MODE=true
# Comma-separated flag keys to force-on in this environment.
FEATURE_FLAGS=

# --- Observability ---------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=true
SENTRY_DSN=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Rates & limits --------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_PER_WINDOW=10
RATE_LIMIT_OTP_PER_WINDOW=5
RATE_LIMIT_API_PER_WINDOW=120
RATE_LIMIT_OFFERS_PER_WINDOW=20

# --- Seed dev accounts (NEVER enable outside development) ------------
SEED_DEV_USERS=true
SEED_DEV_PASSWORD=BidlyDev!2026
